{
  "name": "Production - Podcast Pipeline - Mind Your Health - v1 (Thumbnail Generator)",
  "flow": [
    {
      "id": 15,
      "module": "datastore:GetRecord",
      "version": 1,
      "parameters": {
        "datastore": 146980,
        "returnWrapped": false
      },
      "mapper": {
        "key": "POS_AUTOMATION_SECRET",
        "returnWrapped": false
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "https://app.oceanoblue.net/api/automations/podcast/thumbnails",
        "data": "{\"action\":\"claim\",\"show_slug\":\"mind-your-health\"}",
        "gzip": true,
        "method": "post",
        "headers": [
          {
            "name": "x-pos-automation-secret",
            "value": "{{15.filename}}"
          }
        ],
        "timeout": "300",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "raw",
        "contentType": "application/json",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": false,
        "useQuerystring": false,
        "followAllRedirects": false,
        "rejectUnauthorized": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Episode needs thumbnail",
        "conditions": [
          [
            {
              "a": "{{1.data.id}}",
              "o": "exist"
            }
          ]
        ]
      },
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "video_id",
            "value": "{{1.data.youtube_id}}"
          },
          {
            "name": "episode_id",
            "value": "{{1.data.id}}"
          },
          {
            "name": "ref_base",
            "value": "{{lower(replace(replace(1.data.filename; \".mp4\"; \"\"); \".mov\"; \"\"))}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 13,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "https://app.oceanoblue.net/api/automations/podcast/pick-frames",
        "data": "{\"show_slug\":\"mind-your-health\",\"youtube_id\":\"{{2.video_id}}\",\"hosts_reference_url\":\"https://www.dropbox.com/scl/fi/9l5qr8owqwom2zygcymyk/hosts.jpg?rlkey=olgt8jlx6kxvz89bn6pjld546&st=slrwztb0&dl=1\"}",
        "gzip": true,
        "method": "post",
        "headers": [
          {
            "name": "x-pos-automation-secret",
            "value": "{{15.filename}}"
          }
        ],
        "timeout": "300",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "raw",
        "contentType": "application/json",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": true,
        "useQuerystring": false,
        "followAllRedirects": false,
        "rejectUnauthorized": true
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 10,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "https://app.oceanoblue.net/api/automations/podcast/thumbnails",
        "data": "{\"action\":\"complete\",\"episode_id\":\"{{1.data.id}}\",\"lease_token\":\"{{1.data.lease_token}}\",\"source_mode\":\"original_photos\",\"hosts_url\":\"{{13.data.hosts_frame_url}}\",\"guest_url\":\"{{13.data.guest_frame_url}}\"}",
        "gzip": true,
        "method": "post",
        "headers": [
          {
            "name": "x-pos-automation-secret",
            "value": "{{15.filename}}"
          }
        ],
        "timeout": "300",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "raw",
        "contentType": "application/json",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": false,
        "useQuerystring": false,
        "followAllRedirects": false,
        "rejectUnauthorized": true
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com",
    "notes": []
  }
}
