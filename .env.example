# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers (at least one required for photo processing)
OPENAI_API_KEY=sk-...                 # GPT Image
GEMINI_API_KEY=                       # Google AI Studio - Nano Banana / Banana Pro

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DELIVERY_LINK_SECRET=change-me-to-a-random-string

# Google Maps Places (for address autocomplete in booking wizard)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 (for Google Calendar integration on /dashboard/settings/integrations)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Podcast Production Engine — Make.com automation bridge
# Shared secret Make sends as the `x-pos-automation-secret` header on callbacks.
POS_AUTOMATION_SECRET=change-me-to-a-long-random-string
# Make webhook URL the POS -> Make trigger posts to (keep secret; not in repo).
MAKE_PODCAST_WEBHOOK_URL=

# Optional: branding
NEXT_PUBLIC_BRAND_NAME=Oceano Blue
NEXT_PUBLIC_BRAND_LOGO_URL=
