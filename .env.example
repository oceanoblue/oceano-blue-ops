# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers (at least one required for photo processing)
OPENAI_API_KEY=sk-...                 # GPT Image
GEMINI_API_KEY=                       # Google AI Studio - Nano Banana / Banana Pro

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DELIVERY_LINK_SECRET=change-me-to-a-random-string

# Google Maps Places (address autocomplete in the booking wizard).
# Booking autocomplete now runs SERVER-SIDE via /api/places/* — set a key with
# the "Places API (New)" enabled + billing on, and NO HTTP-referrer restriction
# (server requests have no referrer). This key never reaches the browser.
GOOGLE_MAPS_SERVER_KEY=
# Legacy browser key — no longer used by the booking flow; safe to remove.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 (for Google Calendar integration on /dashboard/settings/integrations)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Dropbox (podcast show folders + contractor RAW photo intake).
# One Dropbox app: store the long-lived refresh token, exchange per call.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_PODCAST_ROOT=/Podcasts
# Per-order contractor upload folders live under this root:
DROPBOX_PHOTO_INTAKE_ROOT=/Photo Intake

# Podcast Production Engine — Make.com automation bridge
# Shared secret Make sends as the `x-pos-automation-secret` header on callbacks.
POS_AUTOMATION_SECRET=change-me-to-a-long-random-string
# Make webhook URL the POS -> Make trigger posts to (keep secret; not in repo).
MAKE_PODCAST_WEBHOOK_URL=

# Optional: branding
NEXT_PUBLIC_BRAND_NAME=Oceano Blue
NEXT_PUBLIC_BRAND_LOGO_URL=
